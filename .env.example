# Shopify App Credentials
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_APP_URL=https://shopify-app-q4bw.onrender.com

# Database
DATABASE_URL="file:./dev.db"

# App Settings
NODE_ENV=development
PORT=3000

# Optional: auto-create OCE API key on install (no manual paste)
# When set, the app calls this endpoint after Shopify OAuth; backend returns { api_key }.
# OCE_INSTALL_URL=https://your-oce-api.example.com/functions/v1/integrations/shopify/install
# OCE_INSTALL_SECRET=your_server_to_server_secret

# Optional: OCE Checkout Pixel (web pixel extension) — full URL to pixel-collect.
# When set, the app activates the pixel on install and when the merchant saves the API key.
# OCE_PIXEL_COLLECT_URL=https://your-project.supabase.co/functions/v1/pixel-collect
