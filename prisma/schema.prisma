// Prisma schema for OCE Shopify App
// Stores merchant settings, API keys, and attribution config

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Shopify session storage (required by @shopify/shopify-app-remix)
model Session {
  id            String   @id
  shop          String
  state         String
  isOnline      Boolean  @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?

  @@index([shop])
}

// Merchant OCE configuration
model OceSettings {
  id                  String   @id @default(cuid())
  shop                String   @unique
  apiKey              String   @default("")
  sdkEnabled          Boolean  @default(true)
  webhookEnabled      Boolean  @default(true)
  portalContent       String   @default("{}") // JSON blob of editable creator portal copy

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([shop])
}

// Log of orders sent to OCE API
model OrderSync {
  id            String   @id @default(cuid())
  shop          String
  shopifyOrderId String
  oceOrderId    String?
  exposureIds   String?  // JSON array of exposure IDs
  status        String   @default("pending") // pending | sent | failed | attributed
  errorMessage  String?
  totalAmount   Float?
  commission    Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shop, shopifyOrderId])
  @@index([shop])
  @@index([status])
}

// Registered video assets
model VideoAsset {
  id          String   @id @default(cuid())
  shop        String
  assetId     String   // OCE asset ID
  title       String?
  creatorName String?
  creatorId   String?
  videoUrl    String?
  skus        String?  // JSON array of associated SKUs
  platform    String?  // videowise | tolstoy | firework | youtube | vimeo | custom
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([shop, assetId])
  @@index([shop])
}

// Creator accounts for the onsite affiliate portal
model Creator {
  id            String   @id @default(uuid())
  shop          String
  name          String
  email         String
  passwordHash  String
  verified      Boolean  @default(false)
  termsAccepted Boolean  @default(false)
  oceCreatorId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  verificationCodes VerificationCode[]
  videos            CreatorVideo[]

  @@unique([shop, email])
  @@index([shop])
}

// Email verification codes for creator signup
model VerificationCode {
  id        String   @id @default(uuid())
  creatorId String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
}

// Videos submitted by creators
model CreatorVideo {
  id         String   @id @default(uuid())
  shop       String
  creatorId  String
  title      String
  videoUrl   String
  skus       String   // JSON array of SKUs
  status     String   @default("pending") // pending | approved | rejected
  oceAssetId String?
  views      Int      @default(0)
  orders     Int      @default(0)
  commission Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([shop])
  @@index([creatorId])
}
