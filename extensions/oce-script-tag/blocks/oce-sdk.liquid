{% comment %}
  OCE SDK Script Tag — Shopify Theme App Extension
  Injects the Onsite Commission Engine tracking SDK into the storefront.
  API key is synced automatically from the app dashboard via metafields.
{% endcomment %}

{% comment %} Optionality: default ON; set to 'false' in app to disable checkout/buy-now intercept. {% endcomment %}
<script>window._oceInterceptAttribution = {% if app.metafields.oce.intercept_attribution == 'false' %}false{% else %}true{% endif %};</script>

{% if app.metafields.oce.api_key != blank %}
  <!-- Onsite Commission Engine SDK -->
  <script
    src="https://app.onsiteaffiliate.com/sdk/oce.min.js?v=1.2.6"
    data-api-key="{{ app.metafields.oce.api_key }}"
    defer
  ></script>
{% endif %}

<!-- Exposure event listener + video auto-tracking -->
<script>
  (function() {
    'use strict';

    var PROXY_URL = '/apps/onsite-affiliate/exposure';
    var tracked = {}; // asset_id → true, prevents duplicate exposures per session

    // ── Session / storage helpers ──────────────────────────────────

    function getSessionId() {
      var key = '_oce_session_id';
      var sessionId = null;
      try { sessionId = localStorage.getItem(key); } catch(e) {}
      if (!sessionId) {
        sessionId = 'oce_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
        try { localStorage.setItem(key, sessionId); } catch(e) {}
      }
      return sessionId;
    }

    function updateCartAttributes(exposureIds, retryCount) {
      retryCount = retryCount || 0;
      var payload = {
        attributes: {
          '_oce_exposure_ids': JSON.stringify(exposureIds),
          '_oce_session_id': getSessionId()
        }
      };
      var bodyStr = JSON.stringify(payload);
      fetch('/cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: bodyStr
      })
      .then(function(r) {
        if (!r.ok && retryCount < 1) {
          return updateCartAttributes(exposureIds, retryCount + 1);
        }
        if (!r.ok) {
          console.warn('[OCE] Cart attributes update failed:', r.status, r.statusText);
        }
      })
      .catch(function(err) {
        if (retryCount < 1) {
          updateCartAttributes(exposureIds, retryCount + 1);
        } else {
          console.warn('[OCE] Failed to update cart attributes:', err);
        }
      });
    }

    function sendCartAttributesBeacon(exposureIds) {
      try {
        var payload = {
          attributes: {
            '_oce_exposure_ids': JSON.stringify(exposureIds),
            '_oce_session_id': getSessionId()
          }
        };
        var blob = new Blob([JSON.stringify(payload)], { type: 'application/json' });
        if (navigator.sendBeacon && navigator.sendBeacon('/cart/update.js', blob)) {
          return true;
        }
      } catch (e) {}
      return false;
    }

    // ── Intercept: checkout / buy-now — 400ms cap, redirect regardless, minimal payload ──
    var INTERCEPT_MAX_MS = 400;

    function getStoredExposureIds() {
      try {
        var raw = sessionStorage.getItem('_oce_exposure_ids');
        return raw ? JSON.parse(raw) : [];
      } catch (e) { return []; }
    }

    function minimalCartSyncOnce(exposureIds, maxMs) {
      if (!exposureIds || exposureIds.length === 0) return;
      var payload = {
        attributes: {
          '_oce_exposure_ids': JSON.stringify(exposureIds),
          '_oce_session_id': getSessionId()
        }
      };
      var controller = typeof AbortController !== 'undefined' ? new AbortController() : null;
      var id = controller ? setTimeout(function() { controller.abort(); }, maxMs) : null;
      fetch('/cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
        signal: controller ? controller.signal : undefined
      }).then(function() {}).catch(function() {}).then(function() {
        if (id) clearTimeout(id);
      });
    }

    function isCheckoutUrl(url) {
      if (!url || typeof url !== 'string') return false;
      try {
        var path = url.indexOf('//') !== -1 ? (new URL(url)).pathname : url;
        return path.indexOf('/checkout') === 0 || path.indexOf('/checkout') !== -1;
      } catch (e) { return url.indexOf('/checkout') !== -1; }
    }

    function setupIntercept() {
      if (window._oceInterceptAttribution === false) return;

      document.addEventListener('click', function(ev) {
        if (window._oceInterceptAttribution === false) return;

        var link = ev.target && ev.target.closest ? ev.target.closest('a') : null;
        if (link && link.href && isCheckoutUrl(link.href)) {
          ev.preventDefault();
          var targetUrl = link.href;
          minimalCartSyncOnce(getStoredExposureIds(), INTERCEPT_MAX_MS);
          setTimeout(function() { window.location.href = targetUrl; }, INTERCEPT_MAX_MS);
          return;
        }

        var form = ev.target && ev.target.closest ? ev.target.closest('form') : null;
        if (form) {
          var formAction = (form.action || '').toString();
          var goesToCheckout = isCheckoutUrl(formAction);
          if (!goesToCheckout && (formAction.indexOf('/cart/add') !== -1 || formAction.indexOf('/cart') === 0)) {
            var returnInput = form.querySelector('input[name="return_to"]');
            var returnTo = returnInput ? returnInput.value : '';
            goesToCheckout = returnTo.indexOf('/checkout') !== -1;
          }
          if (goesToCheckout) {
            ev.preventDefault();
            minimalCartSyncOnce(getStoredExposureIds(), INTERCEPT_MAX_MS);
            setTimeout(function() { form.submit(); }, INTERCEPT_MAX_MS);
          }
        }
      }, true);
    }

    // ── Exposure event listener (stores in session + cart) ─────────

    window.addEventListener('oce:exposure', function(event) {
      var exposureId = event.detail && event.detail.exposure_id;
      if (!exposureId) return;

      var stored = [];
      try {
        var raw = sessionStorage.getItem('_oce_exposure_ids');
        if (raw) stored = JSON.parse(raw);
      } catch(e) {}

      if (stored.indexOf(exposureId) === -1) {
        stored.push(exposureId);
        if (stored.length > 50) stored = stored.slice(-50);
        try {
          sessionStorage.setItem('_oce_exposure_ids', JSON.stringify(stored));
          localStorage.setItem('_oce_exposure_ids', JSON.stringify(stored));
        } catch (e) {}
      }

      try {
        localStorage.setItem('_oce_session_id', getSessionId());
      } catch (e) {}

      updateCartAttributes(stored);
    });

    // ── Asset ID resolution ──────────────────────────────────────

    // These ID formats match the server-side discovery in /api/videos:
    //   Shopify-hosted video:  shopify-video-{numericId}
    //   YouTube:               yt-{videoId}
    //   Vimeo:                 vimeo-{videoId}
    //   Explicit OCE tag:      {custom value}

    function getAssetIdFromVideo(video) {
      // 1. Explicit OCE attribute
      var oceId = video.getAttribute('data-oce-asset-id');
      if (oceId) return oceId;

      // 2. data-media-id on the video element itself
      var mediaId = video.getAttribute('data-media-id');
      if (mediaId) return 'shopify-video-' + mediaId;

      // 3. data-media-id on parent deferred-media element
      var parent = video.closest('deferred-media, [data-media-id]');
      if (parent) {
        mediaId = parent.getAttribute('data-media-id');
        if (mediaId) return 'shopify-video-' + mediaId;
      }

      // 4. Derive from src URL
      var src = video.src || (video.querySelector('source') && video.querySelector('source').src) || '';
      if (src) {
        var path = src.split('?')[0].split('/').pop();
        return 'video-' + path;
      }

      return null;
    }

    function getAssetIdFromIframe(iframe) {
      var src = iframe.src || '';

      // YouTube embed: https://www.youtube.com/embed/{videoId}?...
      var ytMatch = src.match(/youtube\.com\/embed\/([\w-]+)/);
      if (ytMatch) return 'yt-' + ytMatch[1];

      // Vimeo embed: https://player.vimeo.com/video/{videoId}?...
      var vimeoMatch = src.match(/player\.vimeo\.com\/video\/(\d+)/);
      if (vimeoMatch) return 'vimeo-' + vimeoMatch[1];

      // Fallback: check parent deferred-media for data-media-id + detect platform
      var parent = iframe.closest('deferred-media, [data-media-id]');
      if (parent) {
        var mediaId = parent.getAttribute('data-media-id');
        if (mediaId) {
          if (iframe.classList.contains('js-youtube') || src.includes('youtube')) return 'yt-' + mediaId;
          if (iframe.classList.contains('js-vimeo') || src.includes('vimeo')) return 'vimeo-' + mediaId;
          return 'video-' + mediaId;
        }
      }

      return null;
    }

    // ── Exposure creation ────────────────────────────────────────

    function fireExposure(assetId, skuAttr) {
      if (!assetId || tracked[assetId]) return;
      tracked[assetId] = true;

      var sku = skuAttr || '';

      fetch(PROXY_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          asset_id: assetId,
          session_id: getSessionId(),
          sku: sku || undefined
        })
      })
      .then(function(r) {
        return r.text().then(function(text) {
          var data = {};
          try { data = text ? JSON.parse(text) : {}; } catch(e) {
            data = { raw: text };
          }
          if (!r.ok) {
            throw new Error((data && (data.details || data.error || data.raw)) || ('HTTP ' + r.status));
          }
          return data;
        });
      })
      .then(function(data) {
        if (data.exposure_id) {
          window.dispatchEvent(new CustomEvent('oce:exposure', {
            detail: {
              exposure_id: data.exposure_id,
              asset_id: assetId,
              sku: sku
            }
          }));
        } else {
          console.warn('[OCE] Exposure response missing exposure_id for ' + assetId, data);
        }
      })
      .catch(function(err) {
        console.warn('[OCE] Exposure creation failed for ' + assetId + ':', err);
      });
    }

    // ── Element tracking ─────────────────────────────────────────

    function trackVideo(video) {
      if (video._oceTracked) return;
      video._oceTracked = true;

      video.addEventListener('play', function() {
        var assetId = getAssetIdFromVideo(video);
        var sku = video.getAttribute('data-oce-sku') || '';
        fireExposure(assetId, sku);
      });
    }

    function trackIframe(iframe) {
      if (iframe._oceTracked) return;
      iframe._oceTracked = true;

      // YouTube/Vimeo iframes inside <deferred-media> are inserted with
      // autoplay=1 — the user already clicked play. Treat insertion as
      // the exposure event.
      var assetId = getAssetIdFromIframe(iframe);
      if (assetId) {
        var sku = iframe.getAttribute('data-oce-sku') || '';
        fireExposure(assetId, sku);
      }
    }

    function isVideoIframe(iframe) {
      var src = iframe.src || '';
      return src.includes('youtube.com/embed') ||
             src.includes('player.vimeo.com/video') ||
             iframe.classList.contains('js-youtube') ||
             iframe.classList.contains('js-vimeo');
    }

    // ── DOM scanning ─────────────────────────────────────────────

    function scanDOM() {
      // Track <video> elements (play listener)
      var videos = document.querySelectorAll('video');
      for (var i = 0; i < videos.length; i++) {
        trackVideo(videos[i]);
      }

      // Track YouTube/Vimeo <iframe> elements already in the DOM
      var iframes = document.querySelectorAll('iframe');
      for (var j = 0; j < iframes.length; j++) {
        if (isVideoIframe(iframes[j])) {
          trackIframe(iframes[j]);
        }
      }
    }

    // Watch for dynamically inserted elements.
    // Dawn's <deferred-media> renders <video> or <iframe> from a <template>
    // only when the user clicks the play button.
    var observer = new MutationObserver(function(mutations) {
      for (var i = 0; i < mutations.length; i++) {
        var nodes = mutations[i].addedNodes;
        for (var j = 0; j < nodes.length; j++) {
          var node = nodes[j];
          if (node.nodeType !== 1) continue;

          // Direct match
          if (node.tagName === 'VIDEO') {
            trackVideo(node);
          } else if (node.tagName === 'IFRAME' && isVideoIframe(node)) {
            trackIframe(node);
          }

          // Nested matches (e.g. a <div> containing a <video> or <iframe>)
          if (node.querySelectorAll) {
            var nestedVideos = node.querySelectorAll('video');
            for (var k = 0; k < nestedVideos.length; k++) {
              trackVideo(nestedVideos[k]);
            }
            var nestedIframes = node.querySelectorAll('iframe');
            for (var m = 0; m < nestedIframes.length; m++) {
              if (isVideoIframe(nestedIframes[m])) {
                trackIframe(nestedIframes[m]);
              }
            }
          }
        }
      }
    });

    // ── Sync sessionStorage → cart (so order gets exposure_ids) ─────
    // Run on init, cart page, before unload, and when tab becomes visible
    // so exposure IDs are on the cart before checkout even if user navigates quickly.
    function syncStoredExposuresToCart(useBeacon) {
      try {
        var raw = sessionStorage.getItem('_oce_exposure_ids');
        if (!raw) return;
        var stored = JSON.parse(raw);
        if (stored.length === 0) return;
        try {
          localStorage.setItem('_oce_exposure_ids', JSON.stringify(stored));
          localStorage.setItem('_oce_session_id', getSessionId());
        } catch (e) {}
        if (useBeacon) {
          sendCartAttributesBeacon(stored);
        } else {
          updateCartAttributes(stored);
        }
      } catch(e) {}
    }

    // ── Init ───────────────────────────────────────────────────────

    document.addEventListener('DOMContentLoaded', function() {
      scanDOM();
      observer.observe(document.body, { childList: true, subtree: true });
      setupIntercept();

      // Re-sync any exposures from a previous page in this session
      syncStoredExposuresToCart(false);

      // If we're on the cart page, sync immediately and again after short delays
      // so exposure IDs are on the cart before checkout even if user clicks Checkout quickly.
      if (typeof window.location !== 'undefined' && /\/cart(\?|$)/.test(window.location.pathname || '')) {
        syncStoredExposuresToCart(false);
        setTimeout(function() { syncStoredExposuresToCart(false); }, 200);
        setTimeout(function() { syncStoredExposuresToCart(false); }, 600);
      }
    });

    // Before user leaves (e.g. clicks Checkout), use sendBeacon so the request
    // is not cancelled when the page unloads (fetch is often aborted on navigation).
    window.addEventListener('beforeunload', function() {
      syncStoredExposuresToCart(true);
    });

    // When tab becomes visible (e.g. returning to tab before checkout), re-sync
    document.addEventListener('visibilitychange', function() {
      if (document.visibilityState === 'visible') syncStoredExposuresToCart(false);
    });
  })();
</script>

{% schema %}
{
  "name": "OCE Tracking SDK",
  "target": "head",
  "settings": []
}
{% endschema %}
